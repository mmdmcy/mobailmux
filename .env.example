# Mattermost connection. For the included Docker Compose stack, use localhost
# from the machine running Mobailmux.
MOBAILMUX_MATTERMOST_URL=http://localhost:8065
MOBAILMUX_MATTERMOST_BIND=127.0.0.1
MOBAILMUX_TEAM_NAME=agents
MOBAILMUX_TEAM_DISPLAY_NAME=Agents
MOBAILMUX_OWNER_USERNAME=admin
MOBAILMUX_BOT_USERNAME=mobailmux
MOBAILMUX_BOT_TOKEN=

# Slots are name:channel[:default_workdir].
MOBAILMUX_SLOTS=one:agent-one,two:agent-two,three:agent-three
MOBAILMUX_DEFAULT_WORKDIR=~

# Optional per-slot workdirs override MOBAILMUX_DEFAULT_WORKDIR.
# MOBAILMUX_SLOT_ONE_WORKDIR=~/code/project-one
# MOBAILMUX_SLOT_TWO_WORKDIR=~/code/project-two
# MOBAILMUX_SLOT_THREE_WORKDIR=~/code/project-three

# Runtime behavior.
MOBAILMUX_STATE_DIR=~/.local/state/mobailmux
MOBAILMUX_POLL_SECONDS=2
MOBAILMUX_STATUS_SECONDS=60
MOBAILMUX_MAX_PROGRESS_POSTS=80
MOBAILMUX_OUTPUT_SNIPPET_CHARS=1200
MOBAILMUX_MAX_QUEUED_PER_SLOT=5
MOBAILMUX_MAX_LS_ENTRIES=120

# Built-in web UI. Set a real password before exposing beyond localhost.
MOBAILMUX_WEB_HOST=127.0.0.1
MOBAILMUX_WEB_PORT=8765
MOBAILMUX_WEB_PASSWORD=

# Codex driver.
MOBAILMUX_CODEX_BIN=codex
# Fully autonomous Codex runs require this flag. Read docs/security.md first.
MOBAILMUX_CODEX_ARGS=--dangerously-bypass-approvals-and-sandbox
# MOBAILMUX_AGENT_HOME=~
# MOBAILMUX_PATH_EXTRA=~/.local/bin:~/.cargo/bin

# Bootstrap-only admin credentials. Keep these out of git.
MOBAILMUX_ADMIN_USERNAME=admin
MOBAILMUX_ADMIN_EMAIL=admin@example.local
MOBAILMUX_ADMIN_PASSWORD=
MOBAILMUX_BOT_DISPLAY_NAME=Mobailmux
MOBAILMUX_BOT_DESCRIPTION=Mattermost slots for CLI AI agents

# Included Docker Compose Mattermost stack.
MATTERMOST_IMAGE=mattermost/mattermost-team-edition:latest
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=mattermost
POSTGRES_PASSWORD=
POSTGRES_DB=mattermost
