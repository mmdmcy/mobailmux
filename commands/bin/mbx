#!/usr/bin/env bash
set -euo pipefail

program="$(basename "$0")"

usage() {
  cat <<'EOF'
Mobailmux: ten plain tmux terminals, a through j.

Usage:
  mbx ui
  mbx r <a-j>
  mbx status [a-j]
  mbx check [a-j]
  mbx stop <a-j|all>
  mbx save
  mbx restore
  mbx who [a-j] [--format json]
  mbx log <a-j> [-n N] [--format json]
  mbx peek <a-j> [-n N] [--format json]
  mbx help

Commands:
  ui          Open a sidebar of all terminals; tap one to switch to it.
              Narrower than 80 columns (a phone), it is a row of tabs on top.
  r, resume   Create or return to a terminal.
  status      Show whether each terminal is IDLE, ACTIVE, EXITED, or EMPTY.
  check       Guess whether work is ongoing from tmux's last activity time.
  stop        Stop one terminal, or all Mobailmux terminals.
  save        Save now. Mobailmux also saves every 30s in the background.
  restore     After a reboot, bring saved terminals back (mbx ui does this too).

For AI agents (read-only; who and log need jq):
  who         What runs in each terminal: program, state, the Claude Code
              session name, and what it works on. * marks your own terminal.
  log         The recent conversation of the Claude Code or Codex session in a
              terminal, read from its own transcript (last 20 entries; -n N).
  peek        What a terminal shows right now, as plain text, for any program
              (-n N for the last N lines including scrollback).
  Claude Code sessions message each other with Claude Code's own SendMessage
  tool, addressed to the NAME that mbx who shows. mbx never types into a
  terminal to pass a message on.

Examples:
  mbx ui
  mbx r a
  mbx check a
  mbx status
  mbx stop a
  mbx who --format json
  mbx log b -n 5

New terminals start in your home directory. Detach with Ctrl-b d.
Close a terminal by quitting its program and typing exit, or with mbx stop.
Mouse-wheel scrolling is enabled in every Mobailmux terminal.
Mobailmux never runs, clears, or restarts commands inside a terminal, except
typing the saved resume command when it restores terminals after a reboot.
EOF
}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

need_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed"
}

require_slot() {
  local slot="${1:-}"
  [[ "$slot" =~ ^[a-j]$ ]] || die "unknown slot: ${slot:-<missing>} (expected a through j)"
  printf '%s\n' "$slot"
}

session_name() {
  printf '%s-%s\n' "${MBX_SESSION_PREFIX:-mbx}" "$1"
}

is_shell() {
  case "${1##*/}" in
    bash|dash|fish|ksh|sh|tcsh|zsh) return 0 ;;
    *) return 1 ;;
  esac
}

attach_session() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session"
  else
    exec tmux attach-session -t "$session"
  fi
}

enable_mouse() {
  local session="$1"
  tmux set-option -t "$session" mouse on
  enable_clipboard
}

# The command that writes this device's system clipboard, if it has one.
clipboard_command() {
  if command -v pbcopy >/dev/null 2>&1; then
    printf 'pbcopy'
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    printf 'wl-copy'
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
    printf 'xclip -selection clipboard'
  fi
}

# With mouse mode on, a highlight is copied into tmux, not the system
# clipboard, and apps that copy with OSC 52 (Claude Code, Codex) only reach
# terminals that support it (Apple's Terminal does not). Send both to the
# system clipboard directly; without one, still pass OSC 52 outward.
enable_clipboard() {
  local copy
  tmux set-option -s set-clipboard on
  copy="$(clipboard_command)"
  [[ -n "$copy" ]] || return 0
  # Best effort: the host clipboard is a bonus (a client over SSH gets the
  # OSC 52 copy anyway). A failure must never pop up as a tmux message that
  # the person has to dismiss, so output is dropped and the exit code ignored.
  tmux set-option -s copy-command "$copy >/dev/null 2>&1 || true"
  tmux set-hook -g pane-set-clipboard \
    "run-shell -b \"tmux -S '#{socket_path}' save-buffer - 2>/dev/null | $copy >/dev/null 2>&1 || true\""
}

create_slot() {
  local slot="$1" session start_dir
  session="$(session_name "$slot")"
  start_dir="${HOME:?HOME is not set}"
  [[ -d "$start_dir" ]] || die "starting directory does not exist: $start_dir"
  tmux new-session -d -s "$session" -n "$slot" -c "$start_dir"
}

resume_slot() {
  local slot="$1" session
  need_tmux
  session="$(session_name "$slot")"

  if tmux has-session -t "$session" 2>/dev/null; then
    printf 'Returning to terminal %s.\n' "$slot"
  else
    create_slot "$slot"
    printf 'Created terminal %s.\n' "$slot"
  fi

  enable_mouse "$session"
  ensure_saver
  attach_session "$session"
}

slot_state() {
  local session="$1" command dead
  command="$(tmux display-message -p -t "$session" '#{pane_current_command}' 2>/dev/null || true)"
  dead="$(tmux display-message -p -t "$session" '#{pane_dead}' 2>/dev/null || true)"

  if [[ "$dead" == "1" ]]; then
    printf 'EXITED\n'
  elif is_shell "$command"; then
    printf 'IDLE\n'
  else
    printf 'ACTIVE\n'
  fi
}

print_status() {
  local requested="${1:-}" slot session state attached command path
  local slots=(a b c d e f g h i j)
  [[ -z "$requested" ]] || slots=("$requested")

  need_tmux
  printf '%-5s %-8s %-9s %-14s %s\n' SLOT STATE ATTACHED COMMAND DIRECTORY
  for slot in "${slots[@]}"; do
    session="$(session_name "$slot")"
    if ! tmux has-session -t "$session" 2>/dev/null; then
      printf '%-5s %-8s %-9s %-14s %s\n' "$slot" EMPTY - - -
      continue
    fi

    state="$(slot_state "$session")"
    attached="$(tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null || true)"
    command="$(tmux display-message -p -t "$session" '#{pane_current_command}' 2>/dev/null || true)"
    path="$(tmux display-message -p -t "$session" '#{pane_current_path}' 2>/dev/null || true)"
    if [[ "$attached" =~ ^[0-9]+$ ]] && (( attached > 0 )); then
      attached=yes
    else
      attached=no
    fi
    printf '%-5s %-8s %-9s %-14s %s\n' \
      "$slot" "$state" "$attached" "${command:-unknown}" "${path:-unknown}"
  done
}

quiet_seconds() {
  local seconds="${MBX_QUIET_SECONDS:-5}"
  [[ "$seconds" =~ ^[1-9][0-9]*$ ]] || die "MBX_QUIET_SECONDS must be a positive integer"
  printf '%s\n' "$seconds"
}

# mbx check's signal for one pane, and its seconds of silence (or -):
# EXITED, DONE (back at the shell), WORKING, or QUIET past the threshold.
activity_signal() {
  local command="$1" dead="$2" activity="$3" now="$4" threshold="$5" elapsed
  if [[ "$dead" == 1 ]]; then
    printf 'EXITED -\n'
  elif is_shell "$command"; then
    printf 'DONE -\n'
  elif [[ "$activity" =~ ^[0-9]+$ ]]; then
    elapsed=$((now - activity))
    (( elapsed >= 0 )) || elapsed=0
    if (( elapsed >= threshold )); then
      printf 'QUIET %s\n' "$elapsed"
    else
      printf 'WORKING %s\n' "$elapsed"
    fi
  else
    printf 'UNKNOWN -\n'
  fi
}

check_activity() {
  local requested="${1:-}" slot session signal silent command path dead activity elapsed
  local threshold now
  local slots=(a b c d e f g h i j)
  [[ -z "$requested" ]] || slots=("$requested")

  need_tmux
  threshold="$(quiet_seconds)"
  now="$(date +%s)"
  printf '%-5s %-8s %-9s %-14s %s\n' SLOT SIGNAL SILENT COMMAND DIRECTORY
  for slot in "${slots[@]}"; do
    session="$(session_name "$slot")"
    if ! tmux has-session -t "$session" 2>/dev/null; then
      printf '%-5s %-8s %-9s %-14s %s\n' "$slot" EMPTY - - -
      continue
    fi

    command="$(tmux display-message -p -t "$session" '#{pane_current_command}' 2>/dev/null || true)"
    path="$(tmux display-message -p -t "$session" '#{pane_current_path}' 2>/dev/null || true)"
    dead="$(tmux display-message -p -t "$session" '#{pane_dead}' 2>/dev/null || true)"
    activity="$(tmux display-message -p -t "$session" '#{window_activity}' 2>/dev/null || true)"
    read -r signal elapsed <<<"$(activity_signal "$command" "$dead" "$activity" "$now" "$threshold")"
    silent=-
    [[ "$elapsed" == - ]] || silent="${elapsed}s"

    printf '%-5s %-8s %-9s %-14s %s\n' \
      "$slot" "$signal" "$silent" "${command:-unknown}" "${path:-unknown}"
  done
}

stop_one() {
  local slot="$1" quiet="${2:-0}" session
  session="$(session_name "$slot")"
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
    forget_slot "$slot"
    printf 'Stopped terminal %s.\n' "$slot"
    return 0
  fi
  (( quiet )) || printf 'Terminal %s is already empty.\n' "$slot"
  return 1
}

stop_slots() {
  local requested="$1" slot found=0
  need_tmux
  if [[ "$requested" == all ]]; then
    for slot in a b c d e f g h i j; do
      if stop_one "$slot" 1; then
        found=1
      fi
    done
    forget_slot all
    (( found )) || printf 'No Mobailmux terminals are running.\n'
  else
    stop_one "$requested" || true
  fi
}

# --- Reboot persistence -----------------------------------------------------
# tmux cannot survive a reboot, so mbx keeps a small snapshot of each slot: its
# directory and, when it runs Claude Code or Codex, the command that resumes that
# exact conversation. After a reboot, `mbx ui` or `mbx restore` rebuilds the
# slots from it. The snapshot is plain text: slot, directory, command.

snapshot_file() {
  printf '%s/mobailmux/slots.tsv\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

uuid_in() {
  grep -Eo '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' <<<"$1" | tail -n 1 || true
}

# The agent's own command name: "claude" or "codex", else nothing.
agent_name() {
  local first rest
  read -r first rest <<<"$1"
  case "${first##*/}" in
    claude|codex) printf '%s\n' "${first##*/}" ;;
    node|bun)
      read -r first _ <<<"$rest"
      case "$first" in
        *claude*) printf 'claude\n' ;;
        *codex*) printf 'codex\n' ;;
      esac
      ;;
  esac
}

# Flags worth carrying over to the resumed agent. Prompts are never replayed.
agent_flags() {
  local agent="$1" args="$2" word take_next="" out=()
  for word in $args; do
    if [[ -n "$take_next" ]]; then
      out+=("$word")
      take_next=""
      continue
    fi
    case "$agent:$word" in
      claude:--dangerously-skip-permissions|codex:--dangerously-bypass-approvals-and-sandbox|\
      codex:--yolo|codex:--full-auto|codex:--no-alt-screen|codex:--search)
        out+=("$word") ;;
      claude:--model|claude:--permission-mode|codex:--model|codex:-m|codex:--profile|codex:-p)
        out+=("$word")
        take_next=1 ;;
    esac
  done
  [[ -n "$take_next" ]] && unset 'out[${#out[@]}-1]'
  (( ${#out[@]} )) && printf ' %q' "${out[@]}"
  return 0
}

# Print "pid<TAB>args" for the first claude/codex process under a pane.
pane_agent() {
  local parent="$1" table="$2" depth pid args next
  for depth in 1 2 3; do
    next=""
    # awk picks the children: a bash loop over every process is slow.
    while read -r pid _ args; do
      if [[ -n "$(agent_name "$args")" ]]; then
        printf '%s\t%s\n' "$pid" "$args"
        return 0
      fi
      [[ -n "$next" ]] || next="$pid"
    done < <(awk -v parent="$parent" '$2 == parent' <<<"$table")
    [[ -n "$next" ]] || return 1
    parent="$next"
  done
  return 1
}

claude_home() {
  printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

codex_home() {
  printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
}

# A Codex thread's rollout file, its transcript.
codex_rollout() {
  local id="$1" file
  for file in "$(codex_home)"/sessions/*/*/*/rollout-*-"$id".jsonl; do
    [[ -f "$file" ]] || continue
    printf '%s\n' "$file"
    return 0
  done
  return 1
}

# The directory a Codex thread works in, from its rollout file.
codex_thread_dir() {
  local file
  file="$(codex_rollout "$1")" || return 0
  head -n 1 "$file" | sed -n 's/.*"cwd":"\([^"]*\)".*/\1/p'
}

# Codex threads whose writer lock is currently held by a running Codex.
held_codex_threads() {
  local dir
  dir="$(codex_home)/thread-writer-locks"
  [[ -d "$dir" ]] && command -v lsof >/dev/null 2>&1 || return 0
  lsof -Fn +d "$dir" 2>/dev/null | sed -n 's|^n.*/\([0-9a-f-]*\)\.lock$|\1|p' | sort -u
}

# One tab-separated line per running slot: slot, directory, agent (claude,
# codex or -), the agent's pid, its session or thread id (or -), and its
# command line. Claude Code's id and directory come from the CLI's own
# sessions/<pid>.json; a Codex thread's from its command line, or else the one
# held thread no other slot claimed, and it works in the thread's directory.
scan_slots() {
  local table line slot session pane_pid path agent pid args id json
  local rows="" claimed="" open_codex="" held leftover dir
  table="$(ps -A -o pid= -o ppid= -o command= 2>/dev/null || true)"

  while IFS=$'\t' read -r session pane_pid path; do
    [[ "$session" =~ ^${MBX_SESSION_PREFIX:-mbx}-([a-j])$ ]] || continue
    slot="${BASH_REMATCH[1]}"
    agent=- pid=- id=- args=""
    if line="$(pane_agent "$pane_pid" "$table")"; then
      pid="${line%%$'\t'*}"
      args="${line#*$'\t'}"
      agent="$(agent_name "$args")"
      id="$(uuid_in "$args")"
      if [[ "$agent" == claude ]]; then
        json="$(claude_home)/sessions/$pid.json"
        if [[ -f "$json" ]]; then
          line="$(cat "$json")"
          [[ "$line" =~ \"sessionId\":\"([^\"]*)\" ]] && id="${BASH_REMATCH[1]}"
          [[ "$line" =~ \"cwd\":\"([^\"]*)\" ]] && path="${BASH_REMATCH[1]}"
        fi
      elif [[ -n "$id" ]]; then
        claimed+="$id "
      else
        open_codex+="$slot "
      fi
      [[ -n "$id" ]] || id=-
    fi
    rows+="$slot"$'\t'"$path"$'\t'"$agent"$'\t'"$pid"$'\t'"$id"$'\t'"$args"$'\n'
  done < <(tmux list-panes -a -F \
    '#{?#{&&:#{window_active},#{pane_active}},#{session_name},}	#{pane_pid}	#{pane_current_path}' \
    2>/dev/null || true)

  # One Codex slot without an id: give it the one held thread nobody claimed.
  leftover=""
  if [[ "$open_codex" =~ ^[a-j]\ $ ]]; then
    while read -r held; do
      [[ -n "$held" && " $claimed" != *" $held "* ]] || continue
      [[ -z "$leftover" ]] && leftover="$held" || leftover="many"
    done < <(held_codex_threads)
    [[ "$leftover" != many ]] || leftover=""
  fi

  while IFS=$'\t' read -r slot path agent pid id args; do
    [[ -n "$slot" ]] || continue
    if [[ "$agent" == codex ]]; then
      [[ "$id" == - && -n "$leftover" && "$slot " == "$open_codex" ]] && id="$leftover"
      if [[ "$id" != - ]]; then
        dir="$(codex_thread_dir "$id")"
        [[ -n "$dir" && -d "$dir" ]] && path="$dir"
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$slot" "$path" "$agent" "$pid" "$id" "$args"
  done <<<"$rows"
}

save_snapshot() {
  local slot path agent pid id args cmd file tmp rows=""
  file="$(snapshot_file)"
  while IFS=$'\t' read -r slot path agent pid id args; do
    case "$agent" in
      claude)
        cmd="claude$(agent_flags claude "$args")"
        if [[ "$id" == - ]]; then cmd+=" --continue"; else cmd+=" --resume $id"; fi
        ;;
      codex)
        cmd="codex$(agent_flags codex "$args") resume"
        [[ "$id" == - ]] || cmd+=" $id"
        ;;
      *) cmd="" ;;
    esac
    rows+="$slot"$'\t'"$path"$'\t'"$cmd"$'\n'
  done < <(scan_slots)

  # Never overwrite a snapshot with nothing, e.g. right after a reboot.
  [[ -n "$rows" ]] || return 0
  mkdir -p "${file%/*}"
  tmp="$file.$$"
  printf '%s' "$rows" > "$tmp"
  mv -f "$tmp" "$file"
}

forget_slot() {
  local slot="$1" file tmp
  file="$(snapshot_file)"
  [[ -f "$file" ]] || return 0
  if [[ "$slot" == all ]]; then
    rm -f "$file"
    return 0
  fi
  tmp="$file.$$"
  awk -F '\t' -v s="$slot" '$1 != s' "$file" > "$tmp" && mv -f "$tmp" "$file"
  [[ -s "$file" ]] || rm -f "$file"
}

any_slot_running() {
  first_slot existing >/dev/null
}

restore_snapshot() {
  local file slot path cmd session count=0
  file="$(snapshot_file)"
  [[ -s "$file" ]] || { printf 'Nothing to restore.\n'; return 0; }
  while IFS=$'\t' read -r slot path cmd; do
    [[ "$slot" =~ ^[a-j]$ ]] || continue
    session="$(session_name "$slot")"
    tmux has-session -t "=$session" 2>/dev/null && continue
    [[ -d "$path" ]] || path="$HOME"
    tmux new-session -d -s "$session" -n "$slot" -c "$path"
    enable_mouse "$session"
    if [[ -n "$cmd" ]]; then
      tmux send-keys -t "=$session:" -l "$cmd"
      tmux send-keys -t "=$session:" Enter
    fi
    count=$((count + 1))
    printf 'Restored terminal %s in %s%s\n' "$slot" "$path" "${cmd:+: $cmd}"
  done < "$file"
  (( count )) || printf 'All saved terminals are already running.\n'
  ensure_saver
}

# A background job inside the tmux server keeps the snapshot current, attached
# or not. It stops on its own once no slot is left (or with the server).
ensure_saver() {
  local pid env_args=() name
  pid="$(tmux show-options -gqv @mbx_saver_pid 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && ps -o command= -p "$pid" 2>/dev/null | grep -q -- '__saver'; then
    return 0
  fi
  for name in XDG_STATE_HOME MBX_SAVE_SECONDS MBX_SESSION_PREFIX; do
    [[ -n "${!name:-}" ]] && env_args+=("$name=${!name}")
  done
  tmux run-shell -b "$(printf '%q ' env ${env_args[@]+"${env_args[@]}"} "$(self_path)" __saver) >/dev/null 2>&1"
}

saver_loop() {
  local seconds="${MBX_SAVE_SECONDS:-30}"
  [[ "$seconds" =~ ^[1-9][0-9]*$ ]] || seconds=30
  tmux set-option -g @mbx_saver_pid "$$"
  while any_slot_running; do
    save_snapshot 2>/dev/null || true
    sleep "$seconds"
  done
  [[ "$(tmux show-options -gqv @mbx_saver_pid 2>/dev/null)" == "$$" ]] \
    && tmux set-option -gu @mbx_saver_pid 2>/dev/null
  return 0
}

# --- Sidebar UI -------------------------------------------------------------
# `mbx ui` opens a throwaway tmux session: a sidebar pane on the left, and on
# the right a nested tmux client attached to the selected slot. Slots stay
# plain sessions; the UI session only views them and dies when you detach.

self_path() {
  local dir
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  printf '%s/%s\n' "$dir" "$(basename "${BASH_SOURCE[0]}")"
}

ui_prefix() {
  printf '%s-ui-\n' "${MBX_SESSION_PREFIX:-mbx}"
}

ui_width() {
  local width="${MBX_UI_WIDTH:-16}"
  [[ "$width" =~ ^[0-9]+$ ]] && (( width >= 8 )) \
    || die "MBX_UI_WIDTH must be a number of columns, at least 8"
  printf '%s\n' "$width"
}

ui_layout_choice() {
  local layout="${MBX_UI_LAYOUT:-auto}"
  case "$layout" in
    auto|side|top) printf '%s\n' "$layout" ;;
    *) die "MBX_UI_LAYOUT must be auto, side or top, got: $layout" ;;
  esac
}

ui_get() {
  tmux show-options -qv -t "=$1:" "$2" 2>/dev/null || true
}

# Side: the sidebar on the left. Top: one row of tabs above the slot, for
# phones. Auto picks top when the window is narrower than 80 columns, and
# runs again whenever the window is resized (a phone turned sideways).
ui_layout() {
  local ui="$1" sidebar layout cols
  sidebar="$(ui_get "$ui" @mbx_sidebar_pane)"
  [[ -n "$sidebar" ]] || return 0
  layout="$(ui_get "$ui" @mbx_layout_choice)"
  if [[ "$layout" != side && "$layout" != top ]]; then
    cols="$(tmux display-message -p -t "$sidebar" '#{window_width}' 2>/dev/null)" || return 0
    layout=side
    [[ "$cols" =~ ^[0-9]+$ ]] && (( cols < 80 )) && layout=top
  fi
  # The sidebar pane comes first, so even layouts put it left or on top.
  if [[ "$layout" == top ]]; then
    tmux select-layout -t "$sidebar" even-vertical \; resize-pane -t "$sidebar" -y 1
  else
    tmux select-layout -t "$sidebar" even-horizontal \; \
      resize-pane -t "$sidebar" -x "$(ui_get "$ui" @mbx_width)"
  fi
  tmux set-option -t "=$ui:" @mbx_layout "$layout"
  ui_redraw "$ui"
}

ui_redraw() {
  local pid
  pid="$(tmux show-options -pqv -t "$(ui_get "$1" @mbx_sidebar_pane)" @mbx_pid 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -USR1 "$pid" 2>/dev/null || true
}

first_slot() {
  local want="$1" slot
  for slot in a b c d e f g h i j; do
    if tmux has-session -t "=$(session_name "$slot")" 2>/dev/null; then
      [[ "$want" == existing ]] && { printf '%s\n' "$slot"; return 0; }
    else
      [[ "$want" == empty ]] && { printf '%s\n' "$slot"; return 0; }
    fi
  done
  return 1
}

# The tty and session of the nested client in a UI's view pane, if attached.
ui_view_client() {
  local ui="$1" pane tty client_tty client_session
  pane="$(ui_get "$ui" @mbx_view_pane)"
  [[ -n "$pane" ]] || return 1
  tty="$(tmux display-message -p -t "$pane" '#{pane_tty}' 2>/dev/null)" || return 1
  while read -r client_tty client_session; do
    if [[ "$client_tty" == "$tty" ]]; then
      printf '%s %s\n' "$tty" "$client_session"
      return 0
    fi
  done < <(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null)
  return 1
}

# True when this shell runs inside a slot that is being shown by a UI.
inside_ui_view() {
  local tty pane
  tty="$(tmux display-message -p '#{client_tty}' 2>/dev/null)" || return 1
  while IFS= read -r pane; do
    [[ -n "$pane" && "$pane" == "$tty" ]] && return 0
  done < <(tmux list-panes -a -F '#{?#{==:#{@mbx_role},view},#{pane_tty},}' 2>/dev/null)
  return 1
}

open_ui() {
  local width layout self ui initial view sidebar click event size=()
  need_tmux
  width="$(ui_width)"
  layout="$(ui_layout_choice)"
  quiet_seconds >/dev/null
  self="$(self_path)"
  if [[ -n "${TMUX:-}" ]] && inside_ui_view; then
    die "already inside the Mobailmux UI"
  fi

  if ! any_slot_running && [[ -s "$(snapshot_file)" ]]; then
    restore_snapshot
  fi
  initial="$(first_slot existing || true)"
  if [[ -z "$initial" ]]; then
    initial=a
    create_slot "$initial"
  fi
  enable_mouse "$(session_name "$initial")" >/dev/null
  ensure_saver

  if [[ -t 1 ]]; then
    size=(-x "$(tput cols)" -y "$(tput lines)")
  fi
  ui="$(ui_prefix)$$"
  view="$(tmux new-session -d -P -F '#{pane_id}' -s "$ui" -n ui ${size[@]+"${size[@]}"} \
    "$(printf '%q __ui-view %q' "$self" "$ui")")"
  sidebar="$(tmux split-window -h -b -d -P -F '#{pane_id}' -l "$width" -t "$view" \
    "$(printf '%q __ui-sidebar %q' "$self" "$ui")")"

  tmux set-option -p -t "$view" @mbx_role view
  tmux set-option -p -t "$sidebar" @mbx_role sidebar
  tmux set-option -t "=$ui:" @mbx_view "$(session_name "$initial")"
  tmux set-option -t "=$ui:" @mbx_view_pane "$view"
  tmux set-option -t "=$ui:" @mbx_sidebar_pane "$sidebar"
  tmux set-option -t "=$ui:" @mbx_width "$width"
  tmux set-option -t "=$ui:" @mbx_layout_choice "$layout"
  # Every key goes to the slot's own tmux client, so Ctrl-b works as usual.
  tmux set-option -t "=$ui:" prefix None
  tmux set-option -t "=$ui:" prefix2 None
  tmux set-option -t "=$ui:" key-table mbx-ui
  tmux set-option -t "=$ui:" status off
  tmux set-option -t "=$ui:" mouse on
  tmux set-option -t "=$ui:" pane-border-lines single
  tmux set-option -t "=$ui:" pane-border-style fg=colour238
  tmux set-option -t "=$ui:" pane-active-border-style fg=colour238
  tmux set-hook -t "=$ui:" client-attached "set-option destroy-unattached on"
  tmux set-hook -t "=$ui:" client-session-changed "set-option destroy-unattached on"
  tmux set-hook -t "=$ui:" window-resized \
    "run-shell -b \"$(printf '%q' "$self") __ui-layout $ui\""
  ui_layout "$ui"
  # Taps on the sidebar pick a slot; everything else reaches the slot client.
  click="run-shell -b \"$(printf '%q' "$self") __ui-click '#{session_name}' '#{mouse_y}' '#{mouse_x}'\""
  tmux bind-key -T mbx-ui MouseDown1Pane \
    if-shell -F '#{==:#{@mbx_role},sidebar}' "$click" 'select-pane -t = ; send-keys -M'
  # Quick repeated taps arrive as double/triple clicks; treat them as taps too.
  for event in DoubleClick1Pane TripleClick1Pane; do
    tmux bind-key -T mbx-ui "$event" \
      if-shell -F '#{==:#{@mbx_role},sidebar}' "$click" 'send-keys -M'
  done
  tmux select-pane -t "$view"

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$ui"
  else
    exec tmux attach-session -t "=$ui"
  fi
}

ui_show() {
  local ui="$1" session="$2" client
  enable_mouse "$session" >/dev/null
  tmux set-option -t "=$ui:" @mbx_view "$session"
  if client="$(ui_view_client "$ui")"; then
    tmux switch-client -c "${client%% *}" -t "=$session"
  fi
  ui_redraw "$ui"
}

ui_click() {
  local ui="$1" row="$2" col="${3:-}" map at key slot
  # The sidebar is read by row, the tab bar by column.
  if [[ "$(ui_get "$ui" @mbx_layout)" == top ]]; then
    map="$(ui_get "$ui" @mbx_cols)" at="$col"
  else
    map="$(ui_get "$ui" @mbx_rows)" at="$row"
  fi
  [[ "$at" =~ ^[0-9]+$ ]] || return 0
  key="${map:at:1}"
  case "$key" in
    [a-j])
      tmux has-session -t "=$(session_name "$key")" 2>/dev/null || return 0
      ui_show "$ui" "$(session_name "$key")"
      ;;
    +)
      slot="$(first_slot empty)" || return 0
      create_slot "$slot"
      ui_show "$ui" "$(session_name "$slot")"
      ;;
  esac
}

ui_view() {
  local ui="$1" socket="${TMUX%%,*}" target next
  while tmux has-session -t "=$ui" 2>/dev/null; do
    target="$(ui_get "$ui" @mbx_view)"
    if [[ -n "$target" ]] && tmux has-session -t "=$target" 2>/dev/null; then
      env -u TMUX tmux -S "$socket" attach-session -t "=$target" >/dev/null 2>&1 || true
      target="$(ui_get "$ui" @mbx_view)"
      if [[ -n "$target" ]] && tmux has-session -t "=$target" 2>/dev/null; then
        # The slot still exists, so the user detached: close the whole UI.
        # Only kill-session: detach-client here makes tmux 3.4 segfault now
        # and then (destroy-unattached frees the session under the leaving
        # client), taking every slot down with the server.
        tmux kill-session -t "=$ui" 2>/dev/null || true
        return 0
      fi
      # The slot was stopped; show another one.
      next="$(first_slot existing || true)"
      tmux set-option -t "=$ui:" @mbx_view "${next:+$(session_name "$next")}"
    else
      printf '\033[H\033[2J\n  No terminals.\n  Tap + new.\n'
      sleep 1
    fi
  done
}

ui_render() {
  local ui="$1" width view_session client line rows="" out="" now threshold
  local name command path dead activity slot dot label dir selected
  local panes="" layout plus=0
  local tab_slots=() tab_dots=() tab_dirs=() tab_selected=()
  width="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{pane_width}' 2>/dev/null || echo 16)"
  now="$(date +%s)"
  threshold="$(quiet_seconds)"
  layout="$(ui_get "$ui" @mbx_layout)"
  first_slot empty >/dev/null && plus=1

  view_session="$(ui_get "$ui" @mbx_view)"
  if client="$(ui_view_client "$ui")"; then
    name="${client#* }"
    if [[ -n "$name" && "$name" != "$view_session" ]]; then
      view_session="$name"
      tmux set-option -t "=$ui:" @mbx_view "$name"
    fi
  fi

  panes="$(tmux list-panes -a -F \
    '#{?#{&&:#{window_active},#{pane_active}},#{session_name},}	#{pane_current_command}	#{pane_current_path}	#{pane_dead}	#{window_activity}' \
    2>/dev/null || true)"

  out+=$'\033[?7h\033[1m'"$(printf ' %-*.*s' "$((width - 1))" "$((width - 1))" MOBAILMUX)"$'\033[0m\033[K\n\033[K\n'
  rows+=".."
  for slot in a b c d e f g h i j; do
    name="$(session_name "$slot")"
    line="$(grep -m 1 "^$name"$'\t' <<<"$panes" || true)"
    [[ -n "$line" ]] || continue
    IFS=$'\t' read -r _ command path dead activity <<<"$line"
    if [[ "$dead" == 1 ]]; then
      dot=$'\033[31m✕'
    elif is_shell "$command"; then
      dot=$'\033[2m○'
    elif [[ "$activity" =~ ^[0-9]+$ ]] && (( now - activity < threshold )); then
      dot=$'\033[33m●'
    else
      dot=$'\033[32m●'
    fi
    dir="${path%/}"; dir="${dir##*/}"; [[ "$path" == "$HOME" ]] && dir="~"
    selected=""
    [[ "$name" == "$view_session" ]] && selected=$'\033[7m'
    if [[ "$layout" == top ]]; then
      tab_slots+=("$slot") tab_dots+=("$dot") tab_dirs+=("${dir:-/}") tab_selected+=("$selected")
      continue
    fi
    label="$(printf '%-*.*s' "$((width - 5))" "$((width - 5))" "${command:-?}")"
    dir="$(printf '%-*.*s' "$((width - 3))" "$((width - 3))" "${dir:-/}")"
    out+="$selected $slot $dot"$'\033[0m'"$selected $label"$'\033[0m\033[K\n'
    out+="$selected   "$'\033[2m'"$dir"$'\033[0m\033[K\n'
    rows+="$slot$slot"
  done
  if [[ "$layout" == top ]]; then
    ui_tabs "$ui" "$width" "$plus"
    return 0
  fi
  if (( plus )); then
    out+=$'\033[K\n'" "$'\033[36m'"+ new"$'\033[0m\033[K\n'
    rows+=".+"
  fi
  tmux set-option -t "=$ui:" @mbx_rows "$rows"
  printf '\033[H%s\033[J' "$out"
}

# One row of tabs, " a● folder ", from the tab_* arrays of ui_render. Folder
# names shrink evenly until every tab fits, then go; the bar never wraps.
ui_tabs() {
  local ui="$1" width="$2" plus="$3" n="${#tab_slots[@]}" budget cap=0 used len
  local i label tab_width fill bar=$'\033[?7l' cols=""
  budget=$(( width - 1 - 4 * n - 3 * plus ))
  for label in "${tab_dirs[@]}"; do
    (( ${#label} > cap )) && cap=${#label}
  done
  while (( cap > 0 )); do
    used=0
    for label in "${tab_dirs[@]}"; do
      len=${#label}
      (( len > cap )) && len=$cap
      used=$(( used + len + 1 ))
    done
    (( used <= budget )) && break
    cap=$(( cap - 1 ))
  done
  for (( i = 0; i < n; i++ )); do
    label=""
    (( cap > 0 )) && label=" ${tab_dirs[i]:0:cap}"
    bar+="${tab_selected[i]} ${tab_slots[i]}${tab_dots[i]}"$'\033[0m'"${tab_selected[i]}$label "$'\033[0m'
    tab_width=$(( 4 + ${#label} ))
    printf -v fill '%*s' "$tab_width" ''
    cols+="${fill// /${tab_slots[i]}}"
  done
  if (( plus )); then
    bar+=" "$'\033[36m'"+"$'\033[0m'" "
    cols+="+++"
  fi
  tmux set-option -t "=$ui:" @mbx_cols "$cols"
  printf '\033[H\033[J%s' "$bar"
}

ui_sidebar() {
  local ui="$1"
  printf '\033[?25l'
  trap 'printf "\033[?25h"' EXIT
  # Drawing runs in a child: if it ever stops (a failed command, a signal),
  # it starts again instead of leaving the slot alone on screen.
  while tmux has-session -t "=$ui" 2>/dev/null; do
    ( ui_draw "$ui" ) || true
    sleep 1
  done
}

ui_draw() {
  local ui="$1"
  trap ':' USR1
  tmux set-option -p -t "${TMUX_PANE:-}" @mbx_pid "$BASHPID" 2>/dev/null || true
  while tmux has-session -t "=$ui" 2>/dev/null; do
    ui_render "$ui"
    sleep "${MBX_UI_REFRESH:-1}" &
    wait $! 2>/dev/null || kill $! 2>/dev/null || true
  done
}

# --- For agents -------------------------------------------------------------
# Read-only views so an agent (or a person) in one slot can see the others:
# who runs where (mbx who), what an agent said and did, from its own
# transcript (mbx log), and what a terminal shows (mbx peek). Claude Code
# sessions message each other with Claude Code's own SendMessage, addressed to
# the name mbx who shows; mbx never types into a terminal to pass one on.

need_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "$1 needs jq; install it with your package manager (apt install jq, brew install jq)"
}

positive_number() {
  [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || die "$1 needs a positive number, got: ${2:-<missing>}"
  printf '%s\n' "$2"
}

output_format() {
  case "${1:-}" in
    json|text) printf '%s\n' "$1" ;;
    *) die "--format must be json or text, got: ${1:-<missing>}" ;;
  esac
}

# Options of who, log and peek: one slot, -n N, --format json|text.
parse_view_args() {
  local command="$1"
  shift
  view_slot="" view_lines="" view_format=text
  while (( $# )); do
    case "$1" in
      -n|--lines) view_lines="$(positive_number "$1" "${2:-}")"; shift 2 ;;
      --format) view_format="$(output_format "${2:-}")"; shift 2 ;;
      --format=*) view_format="$(output_format "${1#*=}")"; shift ;;
      -*) die "$command: unknown option: $1 (see mbx help)" ;;
      *)
        [[ -z "$view_slot" ]] || die "$command accepts one slot"
        view_slot="$(require_slot "$1")"
        shift
        ;;
    esac
  done
}

# The slot this command runs in, if any.
self_slot() {
  local name
  [[ -n "${TMUX_PANE:-}" ]] || return 0
  name="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)"
  [[ "$name" =~ ^${MBX_SESSION_PREFIX:-mbx}-([a-j])$ ]] && printf '%s\n' "${BASH_REMATCH[1]}"
  return 0
}

claude_transcript() {
  local file
  for file in "$(claude_home)"/projects/*/"$1".jsonl; do
    [[ -f "$file" ]] || continue
    printf '%s\n' "$file"
    return 0
  done
  return 1
}

# The last line of a file containing a fixed text: near the end first (agent
# transcripts can be hundreds of megabytes), then the whole file.
last_line_with() {
  local file="$1" text="$2" line
  [[ -f "$file" ]] || return 0
  line="$(tail -n 400 "$file" | grep -F -- "$text" | tail -n 1 || true)"
  [[ -n "$line" ]] || line="$(grep -F -- "$text" "$file" | tail -n 1 || true)"
  printf '%s\n' "$line"
}

# jq turning one transcript line into conversation entries:
# {time, from, kind: prompt|message|notice|text|tool, tool?, text}.
# shellcheck disable=SC2016
claude_entries='
def tooltext:
  .input as $i
  | if .name == "Bash" then $i.command
    elif .name == "SendMessage" then "to \($i.to // "?"): \($i.message // "")"
    else ($i.file_path // $i.path // $i.pattern // $i.url // $i.query
          // $i.description // $i.skill // $i.prompt // ($i | tostring)) end
  | tostring;
def entries:
  select(.type == "user" or .type == "assistant")
  | select((.isSidechain // false) == false and (.isCompactSummary // false) == false)
  # Injected text (skills, reminders) is meta; a message from another session
  # is meta too, but belongs in the conversation.
  | select((.isMeta // false) == false or .origin.kind == "peer")
  | .timestamp as $t
  | if .type == "user" then
      (.origin.kind // "human") as $k
      | (.message.content | if type == "string" then .
         else ([.[]? | select(.type == "text") | .text] | join("\n")) end) as $text
      | select($text != "")
      | if $k == "peer" then
          {time: $t, from: (.origin.name // "peer"), kind: "message", text: (.origin.body // $text)}
        elif $k == "human" then {time: $t, from: "user", kind: "prompt", text: $text}
        else {time: $t, from: $k, kind: "notice", text: $text} end
    else
      .message.content[]?
      | if .type == "text" then {time: $t, from: "claude", kind: "text", text: .text}
        elif .type == "tool_use" then
          {time: $t, from: "claude", kind: "tool", tool: .name, text: tooltext}
        else empty end
    end;'

# shellcheck disable=SC2016
codex_entries='
def entries:
  select(.type == "event_msg" and .payload.type == "item_completed")
  | .timestamp as $t
  | .payload.item
  | if .type == "UserMessage" then
      {time: $t, from: "user", kind: "prompt",
       text: ([.content[]? | select(.type == "text") | .text] | join("\n"))}
    elif .type == "AgentMessage" then
      {time: $t, from: "codex", kind: "text",
       text: ([.content[]? | select(.type == "Text" or .type == "text") | .text] | join("\n"))}
    elif .type == "CommandExecution" then
      {time: $t, from: "codex", kind: "tool", tool: "shell",
       text: (.command | if type == "array" then .[-1] else tostring end)}
    elif .type == "FileChange" then
      {time: $t, from: "codex", kind: "tool", tool: "edit",
       text: (.changes | if type == "object" then keys | join(", ") else tostring end)}
    else empty end
  | select(.text != "");'

# The last N conversation entries of a transcript, one JSON object per line,
# optionally only one kind. It reads from the end and widens the window until
# it has N entries or has read the whole file.
transcript_entries() {
  local agent="$1" file="$2" want="$3" only="${4:-}" program window=400 total items count
  case "$agent" in
    claude) program="$claude_entries" ;;
    codex) program="$codex_entries" ;;
    *) return 0 ;;
  esac
  # shellcheck disable=SC2016
  program+=' fromjson? | entries | select($only == "" or .kind == $only)'
  total="$(wc -l < "$file")"
  while :; do
    items="$(tail -n "$window" "$file" | jq -R -c --arg only "$only" "$program")"
    count="$(printf '%s' "$items" | awk 'END { print NR }')"
    (( count >= want || window >= total )) && break
    window=$((window * 4))
  done
  [[ -z "$items" ]] || tail -n "$want" <<<"$items"
}

# What the agent in a slot says about itself, as four lines: its own session
# record (JSON or empty), the transcript line with its title, the one with its
# last prompt, and the transcript's path. agents_who reads them in one jq.
agent_info() {
  local agent="$1" pid="$2" id="$3" session="" file="" title="" prompt=""
  case "$agent" in
    claude)
      session="$(cat "$(claude_home)/sessions/$pid.json" 2>/dev/null || true)"
      if [[ "$id" != - ]] && file="$(claude_transcript "$id")"; then
        title="$(last_line_with "$file" '"type":"ai-title"')"
        prompt="$(last_line_with "$file" '"type":"last-prompt"')"
      fi
      ;;
    codex)
      if [[ "$id" != - ]] && file="$(codex_rollout "$id")"; then
        title="$(last_line_with "$(codex_home)/session_index.jsonl" "\"id\":\"$id\"")"
        prompt="$(transcript_entries codex "$file" 1 prompt)"
      fi
      ;;
  esac
  printf '%s\n' "${session//$'\n'/ }" "$title" "$prompt" "$file"
}

agents_who() {
  local requested="$1" format="$2" me now threshold panes line found=0 objects=""
  local slot path agent pid id args command dead activity attached signal silent
  local session title prompt file
  need_tmux
  need_jq who
  threshold="$(quiet_seconds)"
  me="$(self_slot)"
  now="$(date +%s)"
  panes="$(tmux list-panes -a -F \
    '#{?#{&&:#{window_active},#{pane_active}},#{session_name},}	#{pane_current_command}	#{pane_dead}	#{window_activity}	#{session_attached}' \
    2>/dev/null || true)"

  while IFS=$'\t' read -r slot path agent pid id args; do
    [[ -n "$slot" ]] || continue
    [[ -z "$requested" || "$slot" == "$requested" ]] || continue
    found=1
    line="$(grep -m 1 "^$(session_name "$slot")"$'\t' <<<"$panes" || true)"
    IFS=$'\t' read -r _ command dead activity attached <<<"$line"
    read -r signal silent <<<"$(activity_signal "$command" "$dead" "$activity" "$now" "$threshold")"
    { read -r session; read -r title; read -r prompt; read -r file; } \
      < <(agent_info "$agent" "$pid" "$id")
    objects+="$(jq -c -n --arg slot "$slot" --arg me "$me" --arg program "$command" \
      --arg signal "$signal" --arg silent "$silent" --arg attached "$attached" \
      --arg folder "$path" --arg agent "$agent" --arg pid "$pid" --arg id "$id" \
      --arg session "$session" --arg title "$title" --arg prompt "$prompt" --arg file "$file" '
      def maybe: if . == "-" or . == "" then null else . end;
      (($session | fromjson?) // {}) as $s
      | {slot: $slot, you: ($slot == $me), program: ($program | maybe),
         state: ($s.status // ($signal | ascii_downcase)),
         signal: $signal, silent_seconds: ($silent | tonumber? // null),
         attached: (($attached | tonumber? // 0) > 0), folder: $folder,
         agent: ($agent | maybe), pid: ($pid | tonumber? // null),
         name: $s.name, session_id: ($id | maybe), agent_status: $s.status,
         title: (($title | fromjson? | .aiTitle // .thread_name) // null),
         last_prompt: (($prompt | fromjson? | .lastPrompt // .text) // null),
         transcript: ($file | maybe)}'
    )"$'\n'
  done < <(scan_slots)

  if [[ -n "$requested" ]] && (( ! found )); then
    objects="$(jq -c -n --arg slot "$requested" '{slot: $slot, you: false, state: "empty"}')"
  fi
  if [[ "$format" == json ]]; then
    printf '%s' "$objects" | jq -s .
    return 0
  fi
  if [[ -z "$objects" ]]; then
    printf 'No Mobailmux terminals are running. Start one with mbx r a or mbx ui.\n'
    return 0
  fi
  printf '%s' "$objects" | jq -s -r --arg home "$HOME" '
    def cell: if . == null or . == "" then "-" else tostring end;
    def home: if $home != "" and . == $home then "~"
      elif $home != "" and startswith($home + "/") then "~" + .[($home | length):]
      else . end;
    def pad($n): . + (" " * ([$n - length, 0] | max));
    [["SLOT", "STATE", "PROGRAM", "NAME", "FOLDER", "DOING"]]
    + map([.slot + (if .you then "*" else "" end), (.state | cell), (.program | cell),
           (.name | cell), (.folder // "-" | home),
           ((.title // .last_prompt // "-") | split("\n")[0])])
    | (transpose | map(map(length) | max)) as $w
    | .[]
    | [range(0; length) as $i | if $i == length - 1 then .[$i] else (.[$i] | pad($w[$i])) end]
    | join("  ")'
}

agent_log() {
  local slot="$1" want="$2" format="$3" row agent pid id file entries
  need_tmux
  need_jq log
  row="$(scan_slots | grep -m 1 "^$slot"$'\t' || true)"
  [[ -n "$row" ]] || die "terminal $slot is empty (see mbx who)"
  IFS=$'\t' read -r _ _ agent pid id _ <<<"$row"
  [[ "$agent" != - ]] \
    || die "terminal $slot runs no Claude Code or Codex session; mbx peek $slot shows its screen"
  [[ "$id" != - ]] \
    || die "cannot tell which $agent session runs in terminal $slot; mbx peek $slot shows its screen"
  case "$agent" in
    claude) file="$(claude_transcript "$id")" \
      || die "no transcript found for Claude Code session $id; mbx peek $slot shows its screen" ;;
    codex) file="$(codex_rollout "$id")" \
      || die "no rollout file found for Codex thread $id; mbx peek $slot shows its screen" ;;
  esac
  entries="$(transcript_entries "$agent" "$file" "$want")"
  if [[ "$format" == json ]]; then
    printf '%s' "$entries" | jq -s --arg slot "$slot" --arg agent "$agent" --arg pid "$pid" \
      --arg id "$id" --arg file "$file" \
      '{slot: $slot, agent: $agent, pid: ($pid | tonumber? // null), session_id: $id,
        transcript: $file, entries: .}'
    return 0
  fi
  printf '# terminal %s: %s session %s\n# %s\n' "$slot" "$agent" "$id" "$file"
  printf '%s' "$entries" | jq -r '
    def stamp: try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | strflocaltime("%m-%d %H:%M")) catch "?";
    (.time | stamp) as $s
    | if .kind == "tool" then
        (.text | split("\n")) as $lines
        | "\($s)  \(.from): → \(.tool): \($lines[0])\(if ($lines | length) > 1 then " …" else "" end)"
      else "\($s)  \(.from): \(.text | gsub("\n"; "\n    "))" end'
}

# What a terminal shows, without trailing blanks.
trim_screen() {
  awk '{ sub(/[ \t]+$/, ""); line[NR] = $0 } length($0) { last = NR }
    END { for (i = 1; i <= last; i++) print line[i] }'
}

peek_slot() {
  local slot="$1" lines="$2" format="$3" session screen
  need_tmux
  session="$(session_name "$slot")"
  tmux has-session -t "=$session" 2>/dev/null || die "terminal $slot is empty (see mbx who)"
  if [[ -n "$lines" ]]; then
    screen="$(tmux capture-pane -p -J -t "=$session:" -S "-$lines" | trim_screen | tail -n "$lines")"
  else
    screen="$(tmux capture-pane -p -J -t "=$session:" | trim_screen)"
  fi
  if [[ "$format" == json ]]; then
    need_jq peek
    jq -n --arg slot "$slot" --arg screen "$screen" '{slot: $slot, screen: $screen}'
  else
    printf '%s\n' "$screen"
  fi
}

main() {
  local command="${1:-help}" slot
  case "$command" in
    ui)
      [[ $# -eq 1 ]] || die "ui does not accept arguments"
      open_ui
      ;;
    save)
      [[ $# -eq 1 ]] || die "save does not accept arguments"
      need_tmux
      save_snapshot
      ensure_saver
      printf 'Saved %s\n' "$(snapshot_file)"
      ;;
    restore)
      [[ $# -eq 1 ]] || die "restore does not accept arguments"
      need_tmux
      restore_snapshot
      ;;
    __saver) saver_loop ;;
    __ui-view) ui_view "$2" ;;
    __ui-sidebar) ui_sidebar "$2" ;;
    __ui-click) ui_click "$2" "$3" "${4:-}" ;;
    __ui-layout) ui_layout "$2" ;;
    r|resume)
      [[ $# -eq 2 ]] || die "resume needs exactly one slot"
      slot="$(require_slot "$2")"
      resume_slot "$slot"
      ;;
    status|st)
      (( $# <= 2 )) || die "status accepts at most one slot"
      if [[ -n "${2:-}" ]]; then
        slot="$(require_slot "$2")"
        print_status "$slot"
      else
        print_status
      fi
      ;;
    check)
      (( $# <= 2 )) || die "check accepts at most one slot"
      if [[ -n "${2:-}" ]]; then
        slot="$(require_slot "$2")"
        check_activity "$slot"
      else
        check_activity
      fi
      ;;
    stop|q)
      [[ $# -eq 2 ]] || die "stop needs one slot or all"
      if [[ "$2" == all ]]; then
        stop_slots all
      else
        slot="$(require_slot "$2")"
        stop_slots "$slot"
      fi
      ;;
    who)
      shift
      parse_view_args who "$@"
      [[ -z "$view_lines" ]] || die "who does not take -n"
      agents_who "$view_slot" "$view_format"
      ;;
    log)
      shift
      parse_view_args log "$@"
      [[ -n "$view_slot" ]] || die "log needs a slot, for example: mbx log b"
      agent_log "$view_slot" "${view_lines:-20}" "$view_format"
      ;;
    peek)
      shift
      parse_view_args peek "$@"
      [[ -n "$view_slot" ]] || die "peek needs a slot, for example: mbx peek b"
      peek_slot "$view_slot" "$view_lines" "$view_format"
      ;;
    help|-h|--help)
      (( $# <= 1 )) || die "help does not accept arguments"
      usage
      ;;
    *)
      die "unknown command: $command (try 'mbx help')"
      ;;
  esac
}

main "$@"
