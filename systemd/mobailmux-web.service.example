[Unit]
Description=Mobailmux web agent slots
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/mobailmux
Environment=PYTHONUNBUFFERED=1
Environment=MOBAILMUX_ENV=/path/to/mobailmux/.env
ExecStart=/path/to/mobailmux/.venv/bin/mobailmux web
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
